rules_version = '2';
// Spark project. Anyone with the link can read until expiresAt.
// Only the Firebase Auth user in editorUid can write.
// Deploy: npx firebase-tools deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function share(shareId) {
      return get(/databases/$(database)/documents/shares/$(shareId)).data;
    }

    function isOwner(shareId) {
      return signedIn() && share(shareId).editorUid == request.auth.uid;
    }

    function publicLive(shareId) {
      return share(shareId).ready == true && share(shareId).expiresAt > request.time;
    }

    match /accounts/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() < 200
        && request.resource.data.createdAt is timestamp
        && request.resource.size() < 2000;
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.size() < 2000;
      allow delete: if false;
    }

    match /shares/{shareId} {
      allow get: if (resource.data.ready == true && resource.data.expiresAt > request.time)
        || (signedIn() && request.auth.uid == resource.data.editorUid);
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.editorUid == request.auth.uid
        && request.resource.data.ready is bool
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() < 200
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(185, 'd')
        && request.resource.data.createdAt is timestamp
        && request.resource.data.docParts is int
        && request.resource.data.audioParts is int
        && request.resource.data.docParts >= 1
        && request.resource.data.docParts < 80
        && request.resource.data.audioParts >= 0
        && request.resource.data.audioParts < 80
        && request.resource.size() < 20000;

      allow update: if signedIn()
        && request.auth.uid == resource.data.editorUid
        && request.resource.data.editorUid == resource.data.editorUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(185, 'd')
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() < 200
        && request.resource.data.docParts is int
        && request.resource.data.audioParts is int
        && request.resource.data.docParts >= 1
        && request.resource.data.docParts < 80
        && request.resource.data.audioParts >= 0
        && request.resource.data.audioParts < 80
        && request.resource.size() < 20000;

      allow delete: if signedIn() && request.auth.uid == resource.data.editorUid;

      match /parts/{partId} {
        allow get: if publicLive(shareId) || isOwner(shareId);
        allow list: if false;
        allow create, update: if isOwner(shareId)
          && partId.matches('^(doc|audio)-[0-9]{1,4}$')
          && request.resource.data.index is int
          && request.resource.data.index >= 0
          && request.resource.data.index < 80
          && request.resource.size() < 1048576;
        allow delete: if isOwner(shareId);
      }
    }
  }
}
